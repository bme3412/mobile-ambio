{
  "cli": {
    "version": ">= 25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true
    },
    "staging": {
      "extends": "production",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_VOICE_URL": "https://ambio-daily-staging.vercel.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6826860799"
      }
    }
  }
}
