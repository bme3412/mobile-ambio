{
  "name": "mobile-ambio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.61.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.53.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-incall-manager": "^4.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webrtc": "^155.0.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "start:dev": "expo start --dev-client --lan",
    "start:dev:tunnel": "expo start --dev-client --tunnel",
    "eas:login": "npx eas-cli@latest login",
    "eas:init": "npx eas-cli@latest init",
    "device:register": "npx eas-cli@latest device:create",
    "build:ios:dev": "npx eas-cli@latest build --platform ios --profile development",
    "voice:local": "node server/local-voice.cjs",
    "voice:check": "node server/check.cjs",
    "build:android:dev": "npx eas-cli@latest build --platform android --profile development",
    "practice:local": "node --env-file=.env.practice.local server/local-practice.cjs"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.ts?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  }
}
